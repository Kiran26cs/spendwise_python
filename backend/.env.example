# Copy to .env and adjust. Every field maps to spendwise.core.config.Settings.
APP_NAME=SpendWise
APP_VERSION=0.1.0
ENVIRONMENT=local
DEBUG=false
DATABASE_URL=postgresql+psycopg://spendwise:spendwise@localhost:5432/spendwise
LOG_LEVEL=INFO
LOG_JSON=false
BASE_CURRENCY=INR
FX_API_URL=https://api.frankfurter.app
FX_TIMEOUT_SECONDS=5
FX_CACHE_TTL_SECONDS=3600
CORS_ORIGINS=["http://localhost:4200"]
MAX_UPLOAD_MB=5
